# pipeline.env — Configuration for the SimPoint + gem5 pipeline.
# Copy to pipeline.env and edit for your benchmark.

# ── Benchmark identity ──────────────────────────────────────────────
BENCHMARK_NAME="tumor_concept"
BENCHMARK_DEMO_DIR="demo/tumor_concept"

# ── Paths (on the remote server) ────────────────────────────────────
BDM_INSTALL_DIR="${HOME}/biodynamo-v1.05.153"
BDM_FORK_DIR="${HOME}/biodynamo-fork"
GEM5_DIR="${HOME}/gem5-BeSA"             # https://github.com/SAL-Research/gem5-BeSA
WORK_DIR="${HOME}/${BENCHMARK_NAME}_gem5"

# ── Binary & config ─────────────────────────────────────────────────
# Path to the built binary (relative to BDM_FORK_DIR)
BINARY_REL="${BENCHMARK_DEMO_DIR}/build/${BENCHMARK_NAME}"
# Simulation config JSON (relative to BDM_FORK_DIR)
CONFIG_REL="${BENCHMARK_DEMO_DIR}/${BENCHMARK_NAME}_bbv_800.json"

# ── BBV generation (Valgrind exp-bbv) ───────────────────────────────
INTERVAL_SIZE=100000000          # 100M instructions per interval
NUM_ITERATIONS=800               # simulation iterations to run
OMP_THREADS=1                    # must be 1 for deterministic BBV

# ── JIT startup trimming ───────────────────────────────────────────
# Number of BBV intervals consumed by ROOT/cling JIT startup.
# Measure with a zero-iteration baseline run, or set to 0 to skip trim.
TRIM_INTERVALS=160

# ── SimPoint clustering ─────────────────────────────────────────────
SIMPOINT_BIN="${HOME}/SimPoint/bin/simpoint"
SIMPOINT_MAX_K=30
SIMPOINT_NUM_SEEDS=5
SIMPOINT_DIM=15

# ── gem5 configuration ──────────────────────────────────────────────
GEM5_BIN="${GEM5_DIR}/build/X86/gem5.opt"  # built by util/abm/build_gem5.sh
GEM5_ISA="X86"
GEM5_NUM_CORES=2                 # 2 required: main thread + ROOT monitor
GEM5_CLK_FREQ="3GHz"
GEM5_MEM_TYPE="SingleChannelDDR3_1600"
GEM5_MEM_SIZE="4GiB"
# Cache sizes (match target machine per-core)
GEM5_L1D_SIZE="48kB"
GEM5_L1I_SIZE="32kB"
GEM5_L2_SIZE="2MB"

# ── Environment variables passed into gem5 SE mode ──────────────────
# These are set in the simulated process's environment
GEM5_ENV_OMP_NUM_THREADS=1
GEM5_ENV_OMP_PROC_BIND=false
GEM5_ENV_ROOT_HIST=0

# ── Smoke test ──────────────────────────────────────────────────────
SMOKE_TEST_INSTS=1000000000      # 1B instructions

# ── Detailed simulation ─────────────────────────────────────────────
DETAIL_CPU_TYPE="O3"             # O3CPU for detailed simulation
DETAIL_INTERVAL_INSTS=100000000  # 100M instructions per SimPoint
PARALLEL_DETAIL=true             # run all SimPoints in parallel
