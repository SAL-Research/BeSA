# Benchmark-specific configuration for tumor growth.
# Source this AFTER pipeline.env, or copy values into pipeline.env.

BENCHMARK_NAME="tumor_concept"
BENCHMARK_DEMO_DIR="demo/tumor_concept"
BINARY_REL="${BENCHMARK_DEMO_DIR}/build/${BENCHMARK_NAME}"
CONFIG_REL="${BENCHMARK_DEMO_DIR}/${BENCHMARK_NAME}_bbv_800.json"

# Simulation parameters
NUM_ITERATIONS=800
INTERVAL_SIZE=100000000          # 100M instructions

# JIT startup: measured at 160 intervals for ROOT/cling
TRIM_INTERVALS=160

# SimPoint clustering: k=10, selected by BIC
SIMPOINT_MAX_K=30
SIMPOINT_DIM=15

# Notes:
# - Dynamic population: 2,401 initial -> ~133k at 800 iterations
# - Total instructions: ~2.5 trillion (~24,974 intervals)
# - After trimming: 24,814 intervals
# - Top 3 clusters cover ~90% of execution
# - Population growth is unbounded (supercritical branching process,
#   offspring expectation 2p=1.6), so iteration count is capped at 800
