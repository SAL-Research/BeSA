# Benchmark-specific configuration for epidemiology (200M agents).
# Source this AFTER pipeline.env, or copy values into pipeline.env.

BENCHMARK_NAME="epidemiology"
BENCHMARK_DEMO_DIR="demo/epidemiology"
BINARY_REL="${BENCHMARK_DEMO_DIR}/build/${BENCHMARK_NAME}"
CONFIG_REL="${BENCHMARK_DEMO_DIR}/measles.json"

NUM_ITERATIONS=1300
INTERVAL_SIZE=100000000          

TRIM_INTERVALS=160

SIMPOINT_MAX_K=30
SIMPOINT_DIM=15

# Inline config override for Valgrind BBV generation:
# --inline-config '{"bdm::SimParam":{
#   "initial_population_infected":10000000,
#   "initial_population_susceptible":190000000,
#   "number_of_iterations":1300,"repeat":1}}'

# Notes:
# - Static population: 200M agents (fixed count throughout)
# - Total instructions: ~3.4 * 10^14 (~3.4M intervals)
# - One cluster (cluster 11) represents 50.4% of execution
# - Top 4 clusters cover ~84% of execution
# - Perf characterization: IPC ~0.40, memory-bound ~60%
# - Memory: C + kN, C~1.59GB, k~290 bytes/agent
# - 200M agents requires ~59GB RAM; 225M+ OOM-killed on 64GB VM
